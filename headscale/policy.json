{
    "autoApprovers": {
        "routes": {
            "0.0.0.0/0": [
                "default@"
            ],
            "::/0": [
                "default@"
            ]
        }
    },
    "acls": [
        {
            "action": "accept",
            "src": [
                "*"
            ],
            "dst": [
                "*:*"
            ]
        }
    ],
    "ssh": [
      {
        "action": "accept",
        "src": ["autogroup:member"],
        "dst": ["autogroup:member"],
        "users": ["root", "autogroup:nonroot"]
      }
    ]   
}